# Copy to backend/.env for local use. NEVER commit real values; .env is gitignored.
#
# For local development (seed data, demo sign-in) nothing here needs setting: the defaults run
# the app on generated demo data. Live Zoho (test or prod) needs every setting marked REQUIRED.

# Live AI routing and dashboard building. Optional: without a key, routing falls back to the
# keyword router and the dashboard builder to its keyword equivalent.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Environment and sign-in — checked once at startup; a refused combination stops the server
# ---------------------------------------------------------------------------

# Which environment this is: dev | test | prod.
#   dev   seed data only. Unset means dev — and is only allowed over seed data, outside production.
#   test  live Zoho, the approved development/test organisation. Requires NEUIQ_DATA_SOURCE=zoho,
#         NEUIQ_AUTH_MODE=zoho, ZOHO_DC and a real AUTH_SECRET. Not with NODE_ENV=production.
#   prod  live Zoho with NODE_ENV=production. NODE_ENV=production requires NEUIQ_ENV=prod.
# NEUIQ_ENV=

# A label for the Zoho organisation this deployment serves — REQUIRED for test and prod, ignored
# for dev. 3–40 lower-case letters, digits and hyphens, e.g. acme-test / acme-prod. It becomes part
# of the deployment namespace (e.g. test/zoho-com/acme-test) that partitions every cache, the
# dashboard store and (later) sessions, so test and production data can never be read across.
# It is a LABEL, not a verification: NeuIQ cannot yet prove which organisation the Zoho credentials
# belong to. Use a different value for every organisation and environment.
# NEUIQ_ORG_KEY=

# To run the approved .com TEST organisation in the app (not needed for seed/demo development):
#   NEUIQ_ENV=test  NEUIQ_DATA_SOURCE=zoho  NEUIQ_AUTH_MODE=zoho  ZOHO_DC=com
#   NEUIQ_ORG_KEY=<a label for it>  AUTH_SECRET=<generated, below>  plus the ZOHO_* credentials.
# Sign-in stays impossible in that mode until Zoho login (E5) exists.

# Organisation-specific role settings (e.g. NEUIQ_HR_ADMIN_*) are REFUSED at startup until E3.

# How people sign in: demo | zoho. Unset means demo, and only over NEUIQ_DATA_SOURCE=seed.
#   demo  the seeded account picker — NO password. Refused at startup with live data, outside
#         NEUIQ_ENV=dev, or in production, so it can never reach real Zoho People records.
#   zoho  Zoho sign-in. Not built yet: in this mode nobody can sign in (the demo routes are 404
#         and every token is refused). Required whenever NEUIQ_DATA_SOURCE=zoho.
# Any other value stops the server at startup.
# NEUIQ_AUTH_MODE=

# Signs session tokens. Leave EMPTY for dev with demo sign-in (a public demo value is used, which
# is acceptable only there). REQUIRED — and checked at startup — whenever NEUIQ_AUTH_MODE=zoho,
# NEUIQ_ENV is test or prod, or NODE_ENV=production: at least 32 random characters, not a
# placeholder, and a DIFFERENT value per environment. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# API port. 4200 by default - 4000 and 4100 belong to the sibling projects.
PORT=4200

# Which browser origins may call this API. The Vite dev server, by default.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Where the file-backed store writes. Generated on first run, gitignored.
# NEUIQ_DB_DIR=

# ---------------------------------------------------------------------------
# Zoho People
# ---------------------------------------------------------------------------

# Where People records come from. Decided at boot, never at request time - there is no
# fallback to seed data when Zoho errors or returns empty.
#   seed  generated demo data (default in development)
#   zoho  live Zoho People
# NODE_ENV=production REFUSES TO START with seed, including when this is unset.
NEUIQ_DATA_SOURCE=seed

# Zoho data centre: in | com | eu | au | jp | ca | sa. REQUIRED when NEUIQ_DATA_SOURCE=zoho —
# there is NO default; unset or unknown stops the server. Must match where the OAuth client was
# created: a token minted on .in does NOT work against .com endpoints.
#   com  verified through this code (2026-10-13/14) on the approved development/test organisation
#   in   People host reached by curl only (2026-09-07); never minted a token through this code
# A verified data centre names a REGION, not an ORGANISATION: NeuIQ does not yet verify which
# organisation the credentials below belong to. No production organisation is confirmed.
# Ignored while NEUIQ_DATA_SOURCE=seed.
ZOHO_DC=

# OAuth credentials from api-console.zoho.<dc>. Never commit real values. Use separate
# credentials per environment, created inside that environment's own Zoho organisation.
# The app runs without these while NEUIQ_DATA_SOURCE=seed.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# The first day of the organisation's LEAVE year, as MM-DD — check it in Zoho People's leave
# settings; it is not readable through the API. 01-01 for a calendar year, 04-01 for April–March.
# Left unset, the live leave-balance tool REFUSES (unavailable) rather than assume the calendar
# year. Only read when NEUIQ_DATA_SOURCE=zoho.
# ZOHO_PEOPLE_LEAVE_YEAR_START=
